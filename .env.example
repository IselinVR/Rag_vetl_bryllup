# Copy to .env and fill in. .env is gitignored — never commit real values.
# Usage: set -a && . ./.env && set +a && node send-notification.js --dry-run

# EmailJS — dashboard → Account
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Supabase — must be the service_role key (anon cannot read `responses`)
SUPABASE_URL=https://bevrttmvumfodpkauiio.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where --dry-run sends its test email
DRY_RUN_EMAIL=
